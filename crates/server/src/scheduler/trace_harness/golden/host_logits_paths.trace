fx launch Decode{n=3, ctx=Unified, readback=HostLogits}
decode_batch(tokens=[10, 20, 30], seqs=["s1@0:len=5", "s2@1:len=5", "s3@2:len=5"], stream=0)
commit_ctx(s1@0:len=6, n=1, base=5, row=0)
